{
  "extends": "./tsconfig.json",
  "include": ["src/**/*", "tests/**/*"],
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "types": ["jest", "node"]
  }
}
